#!/usr/bin/env bash
# Test shim for claude, used by the factory's Go tests: it records how the worker was started and
# prints the stream of a session that ends in a pull request, so the real binary starts a real
# command in a real worktree and no tokens are spent. Its result line is shaped as the one a session
# run with --json-schema printed on 2026-09-23 with Claude Code 2.1.280: the structured result in
# structured_output, and the same object as JSON text in result.
#
#   CLAUDE_SHIM_LOG    one record per call: the directory it ran in, the branch and commit that
#                      directory is on, the process and its group, every argument and the size of
#                      the longest one in bytes, and every environment variable name (values are
#                      not written: only whether a name is there is ever asked)
#   CLAUDE_SHIM_FAIL   when set, the session ends with this on its error output and exit 1
#   CLAUDE_SHIM_RESULT the structured result of the session as one line of JSON, by default a
#                      complete one of an implement session;
#                      it is printed as it stands, so a test can hand the factory one that does not fit
#                      the schema, or one with any of the schema's fields
#   CLAUDE_SHIM_REPAIR_RESULT
#                      the result of a fix session of the review stage, the one whose schema has the
#                      disputed findings, instead of CLAUDE_SHIM_RESULT; by default one that fixed,
#                      disputed and skipped nothing
#   CLAUDE_SHIM_NO_RESULT when set, the session ends well without printing a result line
#   CLAUDE_SHIM_EXIT   the code the session exits with after its result line, 0 by default
#   CLAUDE_SHIM_ERROR_SUBTYPE when set, the result line says the session ended in an error of this
#                      subtype, with no structured output, as error_max_structured_output_retries does
#   CLAUDE_SHIM_COMMIT the session adds a line to a file of that name in the worktree and commits it,
#                      which is the work a run leaves behind for the branch to carry: every session that
#                      works the branch moves it by one commit. An implement session, one started with
#                      the brief that opens with "Implement issue", commits to work.txt when it is not
#                      set, as an implement session that reports complete has to; set and empty, it
#                      commits nothing
#   CLAUDE_SHIM_THEN_COMMIT
#                      the file every session after the first one CLAUDE_SHIM_LOG records commits its
#                      line to instead, so a fix session can change a file the work session did not
#   CLAUDE_SHIM_THEN_ABORT_MERGE
#                      when set, every session after the first one CLAUDE_SHIM_LOG records aborts a
#                      merge in progress in its worktree before anything else, as a session that gives
#                      the merge it was to resolve up
#   CLAUDE_SHIM_THEN_UNCOMMITTED
#                      when set, every session after the first one CLAUDE_SHIM_LOG records adds its
#                      line to that file and commits nothing, as a fix session that forgot to
#   CLAUDE_SHIM_COMMIT_BACKTICKS
#                      when set, that file is one line of this many backticks instead, which is what a
#                      Markdown fence around its diff has to be longer than
#   CLAUDE_SHIM_SLEEP  when set, the session waits that many seconds before it reports, so a test can
#                      reach a worker that is still going
#   CLAUDE_SHIM_THEN_SLEEP, CLAUDE_SHIM_THEN_RESULT
#                      what every session after the first one CLAUDE_SHIM_LOG records does instead of
#                      CLAUDE_SHIM_SLEEP and CLAUDE_SHIM_RESULT, so a test can have the fix session of
#                      a repair round wait or block while the work session before it reported
#
# The author session of the pr stage, the one started with --tools, is none of those: it is logged to
# CLAUDE_SHIM_AUTHOR_LOG instead, counts as no call above, and reads only these two:
#
#   CLAUDE_SHIM_AUTHOR_RESULT  its structured result as one line of JSON, by default a title and a
#                              body that closes the issue in the branch name
#   CLAUDE_SHIM_AUTHOR_FAIL    when set, it ends with this on its error output and exit 1
#
# A reviewer of the panel, the session started as an agent whose name ends in -reviewer, is none of
# those either: it is logged to
# CLAUDE_SHIM_REVIEW_LOG and reads its result from a file of CLAUDE_SHIM_REVIEWS named after it and the
# how-manieth time it runs, code.2 for the code reviewer's second round, then from one named after it
# alone, and passes with no finding when there is neither. A file that holds FAIL ends it on exit 1
# with that on its error output, and one whose first line is SLEEP <seconds> waits that long first.
# With CLAUDE_SHIM_REVIEW_BARRIER set, a reviewer waits until that many reviewers have started before
# it reports, and fails when they do not within 20 seconds: reviewers run one after the other never
# get past it. With CLAUDE_SHIM_REVIEW_LINGER set, a reviewer stays that many seconds after its result
# line before it exits, as a session does while Claude Code shuts down.
#
# The structured result is the one thing a session owes the factory (ADR 0039). A session started as
# an agent whose tools list leaves out StructuredOutput prints no structured_output, as Claude Code
# does.
#
# Before a session the factory asks this same command for the version of Claude Code. That call is
# answered here and logged apart from the sessions, because the worker log is read as one record per
# session, and so is any plugin command, which the factory never makes and which fails:
#
#   CLAUDE_SHIM_HOST_LOG       one line per call that is no session: its arguments
#   CLAUDE_SHIM_VERSION        what --version prints
#   CLAUDE_SHIM_VERSION_HANG   seconds --version waits before it answers, as a binary that hangs
set -u

host="${CLAUDE_SHIM_HOST_LOG:-/dev/null}"
case "${1:-}" in
  --version)
    printf '%s\n' "$*" >> "$host"
    if [ -n "${CLAUDE_SHIM_VERSION_HANG:-}" ]; then
      sleep "$CLAUDE_SHIM_VERSION_HANG"
    fi
    # Set and empty is a binary that printed nothing, which a run has to notice; unset is a normal one.
    printf '%s\n' "${CLAUDE_SHIM_VERSION-2.1.278 (Claude Code)}"
    exit 0
    ;;
  plugin)
    printf '%s\n' "$*" >> "$host"
    echo "error: the factory runs no plugin command" >&2
    exit 1
    ;;
esac

log="${CLAUDE_SHIM_LOG:-/dev/null}"
# The author session of the pr stage is the one started with --tools: it is logged apart and answers
# apart, so the worker log and every variable above stay about the sessions that work the branch.
author="" agents="" reviewer="" repair="" previous="" structured=1
for argument in "$@"; do
  [ "$argument" = --tools ] && author=1
  [ "$argument" = --agents ] && agents=1
  # Claude Code hands the result of --json-schema over through its StructuredOutput tool. An agent
  # whose tools list leaves that tool out ends with text alone and no structured_output (tried with
  # Claude Code 2.1.282 on 2026-09-25). The factory passes one agent per call.
  [ "$previous" = --agents ] && case "$argument" in
    *'"StructuredOutput"'*) ;;
    *'"tools":'*) structured="" ;;
  esac
  [ "$previous" = --agent ] && case "$argument" in *-reviewer) reviewer="${argument%-reviewer}" ;; esac
  [ "$previous" = --json-schema ] && case "$argument" in *'"disputed"'*) repair=1 ;; esac
  previous="$argument"
done
[ -n "$agents" ] || reviewer=""
[ -z "$reviewer" ] || author=""
[ -z "$author" ] || log="${CLAUDE_SHIM_AUTHOR_LOG:-/dev/null}"
[ -z "$reviewer" ] || log="${CLAUDE_SHIM_REVIEW_LOG:-/dev/null}"
# Reviewers run beside each other, so a record is written under a lock that keeps them whole.
tries=0
while ! mkdir "$log.lock" 2>/dev/null && [ "$tries" -lt 200 ]; do tries=$((tries + 1)); sleep 0.05; done
{
  echo "call"
  # The process and its group first: a test that ends the session early still finds what to look for.
  printf 'pid %s\n' "$$"
  printf 'pgid %s\n' "$(ps -o pgid= -p $$ | tr -d ' ')"
  printf 'cwd %s\n' "$(pwd -P)"
  printf 'branch %s\n' "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo none)"
  printf 'head %s\n' "$(git rev-parse HEAD 2>/dev/null || echo none)"
  for argument in "$@"; do printf 'arg %s\n' "$argument"; done
  # The size of the longest argument in bytes, which Linux holds to 128 KiB each (MAX_ARG_STRLEN): a
  # length is counted in bytes under the C locale.
  printf 'longest %s\n' "$(export LC_ALL=C; n=0; for argument in "$@"; do [ "${#argument}" -le "$n" ] || n=${#argument}; done; echo "$n")"
  env | while IFS= read -r entry; do printf 'env %s\n' "${entry%%=*}"; done
} >> "$log"
rmdir "$log.lock" 2>/dev/null

issue=$(git rev-parse --abbrev-ref HEAD 2>/dev/null | sed -n 's#^[a-z][a-z]*/\([0-9][0-9]*\)-.*#\1#p')

if [ -n "$reviewer" ]; then
  printf '%s\n' '{"type":"system","subtype":"init","model":"claude-sonnet-5","permissionMode":"auto","session_id":"3b7e1d20-6c4a-4e8f-9b1d-2a3c4d5e6f70"}'
  if [ -n "${CLAUDE_SHIM_REVIEW_BARRIER:-}" ]; then
    waited=0
    while [ "$(grep -c '^call$' "$log")" -lt "$CLAUDE_SHIM_REVIEW_BARRIER" ]; do
      waited=$((waited + 1))
      if [ "$waited" -gt 200 ]; then
        echo "the $reviewer reviewer waited for $CLAUDE_SHIM_REVIEW_BARRIER reviewers beside it, and they never came" >&2
        exit 1
      fi
      sleep 0.1
    done
  fi
  round=$(grep -cx "arg $reviewer-reviewer" "$log" 2>/dev/null)
  file=""
  if [ -n "${CLAUDE_SHIM_REVIEWS:-}" ]; then
    for candidate in "$CLAUDE_SHIM_REVIEWS/$reviewer.${round:-1}" "$CLAUDE_SHIM_REVIEWS/$reviewer"; do
      if [ -f "$candidate" ]; then file="$candidate"; break; fi
    done
  fi
  output='{"verdict":"pass","findings":[]}'
  if [ -n "$file" ]; then
    output=$(cat "$file")
    case "$output" in
      SLEEP\ *)
        sleep "$(printf '%s' "$output" | sed -n '1s/^SLEEP //p')" &
        wait
        output=$(printf '%s' "$output" | sed '1d')
        ;;
    esac
    if [ "$output" = FAIL ]; then
      echo "the $reviewer reviewer failed" >&2
      exit 1
    fi
  fi
  if [ -z "$structured" ]; then
    printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"terminal_reason":"completed","num_turns":4,"total_cost_usd":0.5,"result":"I read the change and found nothing to fix.","usage":{"input_tokens":200,"cache_creation_input_tokens":300,"cache_read_input_tokens":5000,"output_tokens":400}}'
    exit 0
  fi
  text=$(printf '%s' "$output" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  printf '{"type":"result","subtype":"success","is_error":false,"terminal_reason":"completed","num_turns":4,"total_cost_usd":0.5,"result":"%s","structured_output":%s,"usage":{"input_tokens":200,"cache_creation_input_tokens":300,"cache_read_input_tokens":5000,"output_tokens":400}}\n' \
    "$text" "$output"
  if [ -n "${CLAUDE_SHIM_REVIEW_LINGER:-}" ]; then
    sleep "$CLAUDE_SHIM_REVIEW_LINGER" &
    wait
  fi
  exit 0
fi

if [ -n "$author" ]; then
  printf '%s\n' '{"type":"system","subtype":"init","model":"claude-opus-5","permissionMode":"auto","session_id":"9a1c3e70-2b4d-4f6e-8a0b-1c2d3e4f5a6b"}'
  if [ -n "${CLAUDE_SHIM_AUTHOR_FAIL:-}" ]; then
    echo "$CLAUDE_SHIM_AUTHOR_FAIL" >&2
    exit 1
  fi
  output="${CLAUDE_SHIM_AUTHOR_RESULT:-}"
  [ -n "$output" ] || output=$(printf '{"title":"feat: the work of issue %s","body":"Closes #%s\\n\\nWhat the branch changes."}' "${issue:-0}" "${issue:-0}")
  text=$(printf '%s' "$output" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
  printf '{"type":"result","subtype":"success","is_error":false,"terminal_reason":"completed","num_turns":3,"total_cost_usd":0.25,"result":"%s","structured_output":%s,"usage":{"input_tokens":300,"cache_creation_input_tokens":400,"cache_read_input_tokens":9000,"output_tokens":600}}\n' \
    "$text" "$output"
  exit 0
fi

calls=$(grep -c '^call$' "$log" 2>/dev/null)
prompt="" previous=""
for argument in "$@"; do
  [ "$previous" = -p ] && prompt="$argument"
  previous="$argument"
done
case "$prompt" in "Implement issue "*) CLAUDE_SHIM_COMMIT=${CLAUDE_SHIM_COMMIT-work.txt} ;; esac
if [ "${calls:-0}" -gt 1 ]; then
  [ -n "${CLAUDE_SHIM_THEN_SLEEP:-}" ] && CLAUDE_SHIM_SLEEP=$CLAUDE_SHIM_THEN_SLEEP
  [ -n "${CLAUDE_SHIM_THEN_RESULT:-}" ] && CLAUDE_SHIM_RESULT=$CLAUDE_SHIM_THEN_RESULT
  [ -n "${CLAUDE_SHIM_THEN_COMMIT:-}" ] && CLAUDE_SHIM_COMMIT=$CLAUDE_SHIM_THEN_COMMIT
  [ -z "${CLAUDE_SHIM_THEN_ABORT_MERGE:-}" ] || git merge --abort >/dev/null 2>&1 || true
fi

if [ -n "${CLAUDE_SHIM_FAIL:-}" ]; then
  echo "$CLAUDE_SHIM_FAIL" >&2
  exit 1
fi

output="${CLAUDE_SHIM_RESULT:-}"
if [ -n "$repair" ]; then
  output="${CLAUDE_SHIM_REPAIR_RESULT:-}"
  [ -n "$output" ] || output='{"outcome":"complete","fixed":[],"disputed":[],"skipped":[],"summary":"nothing to fix"}'
fi
if [ -z "$output" ]; then
  output='{"outcome":"complete","commits":["c0ffee0 feat: the work"],"summary":"implemented the issue"}'
fi

printf '%s\n' '{"type":"system","subtype":"init","model":"claude-opus-5","permissionMode":"auto","session_id":"5f2d8c11-0b9e-4a3f-9d21-7c6e4b0a1f33"}'

if [ -n "${CLAUDE_SHIM_COMMIT:-}" ]; then
  mkdir -p "$(dirname "$CLAUDE_SHIM_COMMIT")"
  if [ -n "${CLAUDE_SHIM_COMMIT_BACKTICKS:-}" ]; then
    { head -c "$CLAUDE_SHIM_COMMIT_BACKTICKS" /dev/zero | tr '\0' '`'; echo; } > "$CLAUDE_SHIM_COMMIT"
  else
    printf 'the work of session %s\n' "${calls:-1}" >> "$CLAUDE_SHIM_COMMIT"
  fi
  if [ "${calls:-0}" -le 1 ] || [ -z "${CLAUDE_SHIM_THEN_UNCOMMITTED:-}" ]; then
    git add -A >/dev/null 2>&1
    git -c user.email=worker@example.com -c user.name=worker commit -q -m "feat: $CLAUDE_SHIM_COMMIT" >/dev/null 2>&1
  fi
fi

# In a child, so that the signal the factory ends the session with is taken while it waits.
if [ -n "${CLAUDE_SHIM_SLEEP:-}" ]; then
  sleep "$CLAUDE_SHIM_SLEEP" &
  wait
fi

if [ -n "${CLAUDE_SHIM_NO_RESULT:-}" ]; then
  exit 0
fi

if [ -n "${CLAUDE_SHIM_ERROR_SUBTYPE:-}" ]; then
  printf '{"type":"result","subtype":"%s","is_error":true,"num_turns":12,"total_cost_usd":1.5,"usage":{"input_tokens":900,"cache_creation_input_tokens":1200,"cache_read_input_tokens":40000,"output_tokens":3000}}\n' \
    "$CLAUDE_SHIM_ERROR_SUBTYPE"
  exit "${CLAUDE_SHIM_EXIT:-0}"
fi

if [ -z "$structured" ]; then
  printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"terminal_reason":"completed","num_turns":12,"total_cost_usd":1.5,"result":"I implemented the issue and committed the work.","usage":{"input_tokens":900,"cache_creation_input_tokens":1200,"cache_read_input_tokens":40000,"output_tokens":3000}}'
  exit "${CLAUDE_SHIM_EXIT:-0}"
fi

# The result text is the output as a JSON string: its quotes and backslashes escaped, which is all a
# line of JSON can carry.
text=$(printf '%s' "$output" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
printf '{"type":"result","subtype":"success","is_error":false,"terminal_reason":"completed","num_turns":12,"total_cost_usd":1.5,"result":"%s","structured_output":%s,"usage":{"input_tokens":900,"cache_creation_input_tokens":1200,"cache_read_input_tokens":40000,"output_tokens":3000}}\n' \
  "$text" "$output"
exit "${CLAUDE_SHIM_EXIT:-0}"
