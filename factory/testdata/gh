#!/usr/bin/env bash
# Test shim for gh, used by the factory's Go tests: it logs every call and answers the reads of the
# live queue from canned files, so the real binary runs against a real command line and no GitHub.
#
#   GH_SHIM_DIR      the answers: one file per request, named after it (see the test's ghShim)
#   GH_SHIM_LOG      every call, one request per line
#   GH_SHIM_REMOTES  where `gh repo clone owner/name` clones from: the directory owner-name in here
#   GH_SHIM_FAIL     a file holding a shell pattern; a request that matches it fails as an
#                    unreachable GitHub does. It is read per call, so a test can break GitHub and
#                    mend it again while the factory runs
#   GH_SHIM_STALL    a file holding a shell pattern; a request that matches it is reached and never
#                    answered, as a GitHub that takes a call and says nothing is. It is read per
#                    call, so a test can stop the factory inside one act of a claim
#   GH_SHIM_HANG     a file holding a number of seconds; `gh repo clone` then sleeps that long in a
#                    child of its own instead of cloning, as a clone of a large repository does, and
#                    writes that child's pid beside the file
#   GH_SHIM_BODIES   a directory the body of every call that reads one from standard input
#                    (`--body-file -`, `--input -`) is appended to, in a file named after the request,
#                    so a test can read what the factory wrote to GitHub
#   GH_SHIM_GATE     a file path that holds the claim: a ref creation writes "<path>.<pid>" and waits
#                    for "<path>.open" before it touches the repository, so a test can have two
#                    claimers inside the one act that decides the race
#
# The creation of a reference is not canned but done on the local repository the clone came from,
# with git's own ref lock, because that is the act GitHub refuses the second caller of and the whole
# claim rests on it being atomic. Its removal is done there too, so a test can read back that a
# branch with work on it is still where the factory found it.
#
# A request without an answer fails, so a call the factory makes and the test did not plan for is
# seen rather than answered with nothing. The calls of the pr and ci stages are the exception:
# unanswered, the issue has a text, the pull request is opened and it is green, because nearly every
# run goes through those stages.
set -u

request="$*"
printf '%s\n' "$request" >> "${GH_SHIM_LOG:-/dev/null}"

named=$(printf '%s' "$request" | tr -c 'A-Za-z0-9' '-')

# A call that reads its body from standard input: it is kept where the test reads it, under the name
# of the request. It is read here, before any answer is decided, so that gh never leaves a body in a
# pipe nobody empties — a call that fails or stalls reads it as the one that is answered does.
input=""
case " $request " in
  *" --body-file - "*|*" --input - "*)
    # Read whole and kept as it came, to the last newline, which $(...) alone would take off.
    input=$(cat; printf x); input=${input%x}
    if [ -n "${GH_SHIM_BODIES:-}" ]; then
      mkdir -p "$GH_SHIM_BODIES"
      printf '%s' "$input" >> "$GH_SHIM_BODIES/$named"
    fi
    ;;
esac

failing=$(cat "${GH_SHIM_FAIL:-/nowhere}" 2>/dev/null || true)
if [ -n "$failing" ]; then
  # shellcheck disable=SC2254  # the variable is the pattern: the test writes it
  case "$request" in
    $failing) echo "gh: error connecting to api.github.com" >&2; exit 1 ;;
  esac
fi

stalling=$(cat "${GH_SHIM_STALL:-/nowhere}" 2>/dev/null || true)
if [ -n "$stalling" ]; then
  # shellcheck disable=SC2254  # the variable is the pattern: the test writes it
  case "$request" in
    # In a child, so that the signal the factory ends this call with is taken while it waits.
    $stalling) sleep 600 & wait; exit 1 ;;
  esac
fi

if [ "${1:-}" = repo ] && [ "${2:-}" = clone ]; then
  repository=${3:-}; target=${4:-}
  hang=$(cat "${GH_SHIM_HANG:-/nowhere}" 2>/dev/null || true)
  if [ -n "$hang" ]; then
    sleep "$hang" &
    echo $! > "${GH_SHIM_HANG}.pid"
    wait
    exit 1
  fi
  source="${GH_SHIM_REMOTES:-/nowhere}/${repository%%/*}-${repository#*/}"
  [ -d "$source" ] || { echo "gh: Could not resolve to a Repository with the name '$repository'." >&2; exit 1; }
  exec git clone --quiet "$source" "$target"
fi

# The claim: POST repos/<owner>/<name>/git/refs -f ref=refs/heads/<branch> -f sha=<commit>. It is
# `git update-ref <ref> <sha> ""`, which creates a reference and fails when it exists already —
# git's ref lock decides the race here as GitHub's 422 decides it there.
path="${4:-}"
if [ "${1:-}" = api ] && [ "${2:-}" = --method ] && [ "${3:-}" = POST ] && [ "$path" != "${path#repos/}" ] && [ "$path" != "${path%/git/refs}" ]; then
  repository=${path#repos/}; repository=${repository%/git/refs}
  remote="${GH_SHIM_REMOTES:-/nowhere}/${repository%%/*}-${repository#*/}"
  ref=""; sha=""
  shift 4
  while [ $# -gt 0 ]; do
    case "${1:-}" in
      -f|--raw-field|-F|--field)
        case "${2:-}" in
          ref=*) ref=${2#ref=} ;;
          sha=*) sha=${2#sha=} ;;
        esac
        shift ;;
    esac
    shift
  done
  gate="${GH_SHIM_GATE:-}"
  if [ -n "$gate" ]; then
    : > "$gate.$$"
    # The factory that called ends it when it gives up, and nothing does once that factory is gone:
    # the wait ends with it, so a test process that was killed leaves no loop polling for a gate.
    while [ ! -f "$gate.open" ] && kill -0 "$PPID" 2>/dev/null; do sleep 0.02; done
    [ -f "$gate.open" ] || exit 1
  fi
  if git -C "$remote" update-ref "$ref" "$sha" "" 2>/dev/null; then
    printf '{"ref":"%s","object":{"sha":"%s"}}\n' "$ref" "$sha"
    exit 0
  fi
  if git -C "$remote" rev-parse --verify --quiet "$ref" >/dev/null; then
    echo "gh: Reference already exists (HTTP 422)" >&2
    exit 1
  fi
  echo "gh: $ref of $repository could not be created (HTTP 422)" >&2
  exit 1
fi

# The removal of a branch: DELETE repos/<owner>/<name>/git/refs/heads/<branch>. It is done on the
# local repository too, because what the factory must never delete is read back from it afterwards.
if [ "${1:-}" = api ] && [ "${2:-}" = --method ] && [ "${3:-}" = DELETE ]; then
  case "$path" in
    repos/*/git/refs/heads/*)
      rest=${path#repos/}
      repository=${rest%%/git/refs/heads/*}
      ref="refs/heads/${rest#*/git/refs/heads/}"
      remote="${GH_SHIM_REMOTES:-/nowhere}/${repository%%/*}-${repository#*/}"
      git -C "$remote" update-ref -d "$ref" 2>/dev/null && exit 0
      echo "gh: Reference does not exist (HTTP 422)" >&2
      exit 1 ;;
  esac
fi

answer="${GH_SHIM_DIR:-/nowhere}/$named"
[ -f "$answer" ] && exec cat "$answer"

# The reads of the ci stage a test did not answer: every pull request is green — mergeable, of the
# branch of its number on the local repository, one check passed long ago, no review, no thread —
# and a branch has no open pull request; a reply in a thread and its resolution go through. A test of
# the ci stage answers them otherwise.
case "$request" in
  "pr view "*" --repo "*" --json mergeable,headRefName,headRefOid,isCrossRepository,commits,statusCheckRollup")
    number=$3; repository=$5
    remote="${GH_SHIM_REMOTES:-/nowhere}/${repository%%/*}-${repository#*/}"
    branch=$(git -C "$remote" for-each-ref --format='%(refname:lstrip=2)' refs/heads 2>/dev/null | grep -m1 "^[a-z]*/$number-" || true)
    printf '{"mergeable":"MERGEABLE","headRefName":"%s","headRefOid":"c0ffee","isCrossRepository":false,"commits":[{"committedDate":"2026-01-01T00:00:00Z"}],"statusCheckRollup":[{"name":"gate","status":"COMPLETED","conclusion":"SUCCESS","completedAt":"2026-01-01T00:00:00Z"}]}\n' "$branch"
    exit 0 ;;
  "api --paginate repos/"*"/pulls/"*"/reviews?per_page=100"|"api repos/"*"/pulls?state=open&head="*"&per_page=10")
    echo '[]'; exit 0 ;;
  "api graphql --input -")
    echo '{"data":{"repository":{"pullRequest":{"reviewThreads":{"nodes":[]}}}}}'; exit 0 ;;
  # The two calls of the pr stage: the issue its author is briefed with, and the pull request it
  # opens, numbered after the issue of the branch it is opened from.
  "issue view "*" --repo "*" --json title,body")
    printf '{"title":"issue %s","body":"The text of issue %s."}\n' "$3" "$3"; exit 0 ;;
  "api --method POST repos/"*"/pulls --input -")
    repository=${4#repos/}; repository=${repository%/pulls}
    number=$(printf '%s' "$input" | sed -n 's#.*"head":"[a-z][a-z]*/\([0-9][0-9]*\)-[^"]*".*#\1#p')
    printf '{"number":%s,"html_url":"https://github.com/%s/pull/%s","draft":false}\n' "${number:-1}" "$repository" "${number:-1}"
    exit 0 ;;
  "api graphql --input - --jq .data.addPullRequestReviewThreadReply.comment.url")
    echo 'https://github.com/o/r/pull/1#discussion_r1'; exit 0 ;;
  "api graphql --input - --jq .data.resolveReviewThread.thread.isResolved")
    echo true; exit 0 ;;
esac

echo "gh: the shim has no answer for: $request" >&2
exit 1
