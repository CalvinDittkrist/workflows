#!/usr/bin/env bash
# Test shim for gh, used by the factory's Go tests: it logs every call and answers the reads of the
# live queue from canned files, so the real binary runs against a real command line and no GitHub.
#
#   GH_SHIM_DIR      the answers: one file per request, named after it (see the test's ghShim)
#   GH_SHIM_LOG      every call, one request per line
#   GH_SHIM_REMOTES  where `gh repo clone owner/name` clones from: the directory owner-name in here
#   GH_SHIM_FAIL     a file holding a shell pattern; a request that matches it fails as an
#                    unreachable GitHub does. It is read per call, so a test can break GitHub and
#                    mend it again while the factory runs
#   GH_SHIM_STALL    a file holding a shell pattern; a request that matches it is reached and never
#                    answered, as a GitHub that takes a call and says nothing is. It is read per
#                    call, so a test can stop the factory inside one act of a claim
#   GH_SHIM_HANG     a file holding a number of seconds; `gh repo clone` then sleeps that long in a
#                    child of its own instead of cloning, as a clone of a large repository does, and
#                    writes that child's pid beside the file
#   GH_SHIM_BODIES   a directory the body of every call that reads one from standard input
#                    (`--body-file -`) is appended to, in a file named after the request, so a test
#                    can read what the factory wrote to GitHub
#   GH_SHIM_GATE     a file path that holds the claim: a ref creation writes "<path>.<pid>" and waits
#                    for "<path>.open" before it touches the repository, so a test can have two
#                    claimers inside the one act that decides the race
#
# The creation of a reference is not canned but done on the local repository the clone came from,
# with git's own ref lock, because that is the act GitHub refuses the second caller of and the whole
# claim rests on it being atomic.
#
# A request without an answer fails, so a call the factory makes and the test did not plan for is
# seen rather than answered with nothing.
set -u

request="$*"
printf '%s\n' "$request" >> "${GH_SHIM_LOG:-/dev/null}"

failing=$(cat "${GH_SHIM_FAIL:-/nowhere}" 2>/dev/null || true)
if [ -n "$failing" ]; then
  # shellcheck disable=SC2254  # the variable is the pattern: the test writes it
  case "$request" in
    $failing) echo "gh: error connecting to api.github.com" >&2; exit 1 ;;
  esac
fi

stalling=$(cat "${GH_SHIM_STALL:-/nowhere}" 2>/dev/null || true)
if [ -n "$stalling" ]; then
  # shellcheck disable=SC2254  # the variable is the pattern: the test writes it
  case "$request" in
    # In a child, so that the signal the factory ends this call with is taken while it waits.
    $stalling) sleep 600 & wait; exit 1 ;;
  esac
fi

if [ "${1:-}" = repo ] && [ "${2:-}" = clone ]; then
  repository=${3:-}; target=${4:-}
  hang=$(cat "${GH_SHIM_HANG:-/nowhere}" 2>/dev/null || true)
  if [ -n "$hang" ]; then
    sleep "$hang" &
    echo $! > "${GH_SHIM_HANG}.pid"
    wait
    exit 1
  fi
  source="${GH_SHIM_REMOTES:-/nowhere}/${repository%%/*}-${repository#*/}"
  [ -d "$source" ] || { echo "gh: Could not resolve to a Repository with the name '$repository'." >&2; exit 1; }
  exec git clone --quiet "$source" "$target"
fi

# The claim: POST repos/<owner>/<name>/git/refs -f ref=refs/heads/<branch> -f sha=<commit>. It is
# `git update-ref <ref> <sha> ""`, which creates a reference and fails when it exists already —
# git's ref lock decides the race here as GitHub's 422 decides it there.
path="${4:-}"
if [ "${1:-}" = api ] && [ "${2:-}" = --method ] && [ "${3:-}" = POST ] && [ "$path" != "${path#repos/}" ] && [ "$path" != "${path%/git/refs}" ]; then
  repository=${path#repos/}; repository=${repository%/git/refs}
  remote="${GH_SHIM_REMOTES:-/nowhere}/${repository%%/*}-${repository#*/}"
  ref=""; sha=""
  shift 4
  while [ $# -gt 0 ]; do
    case "${1:-}" in
      -f|--raw-field|-F|--field)
        case "${2:-}" in
          ref=*) ref=${2#ref=} ;;
          sha=*) sha=${2#sha=} ;;
        esac
        shift ;;
    esac
    shift
  done
  gate="${GH_SHIM_GATE:-}"
  if [ -n "$gate" ]; then
    : > "$gate.$$"
    while [ ! -f "$gate.open" ]; do sleep 0.02; done
  fi
  if git -C "$remote" update-ref "$ref" "$sha" "" 2>/dev/null; then
    printf '{"ref":"%s","object":{"sha":"%s"}}\n' "$ref" "$sha"
    exit 0
  fi
  if git -C "$remote" rev-parse --verify --quiet "$ref" >/dev/null; then
    echo "gh: Reference already exists (HTTP 422)" >&2
    exit 1
  fi
  echo "gh: $ref of $repository could not be created (HTTP 422)" >&2
  exit 1
fi

named=$(printf '%s' "$request" | tr -c 'A-Za-z0-9' '-')

# A call that reads its body from standard input: it is kept where the test reads it, under the name
# of the request, and the call itself is answered like every other one. The body is read whatever
# happens to it, so gh never writes into a pipe nobody empties.
case " $request " in
  *" --body-file - "*)
    if [ -n "${GH_SHIM_BODIES:-}" ]; then
      mkdir -p "$GH_SHIM_BODIES"
      cat >> "$GH_SHIM_BODIES/$named"
    else
      cat > /dev/null
    fi
    ;;
esac

answer="${GH_SHIM_DIR:-/nowhere}/$named"
[ -f "$answer" ] || { echo "gh: the shim has no answer for: $request" >&2; exit 1; }
cat "$answer"
