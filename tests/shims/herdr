#!/usr/bin/env bash
# Test shim for herdr: logs calls, returns canned JSON shaped like herdr 0.9.
printf 'herdr %s\n' "$*" >> "${SHIM_LOG:-/dev/null}"
# Argv-preserving log: "$*" above collapses quoting, so word-splitting regressions are invisible there.
{ printf 'herdr'; for a in "$@"; do printf '\037%s' "${a//$'\n'/$'\036'}"; done; printf '\n'; } >> "${SHIM_ARGV_LOG:-/dev/null}"
case "$1 $2" in
  "worktree create")
    # Create the worktree for real so later git commands behave; parse --branch/--base/--cwd.
    b=""; base=""; cwd=""; p=""; while [ $# -gt 0 ]; do case "$1" in --branch) shift; b=$1;; --base) shift; base=$1;; --cwd) shift; cwd=$1;; --path) shift; p=$1;; esac; shift; done
    [ -n "$p" ] || p="${SHIM_WT_ROOT:?}/$(printf '%s' "$b" | tr '/' '-')"
    printf '%s' "$p" > "${SHIM_WT_ROOT:?}/.ws-w9"
    git -C "$cwd" worktree add -q -b "$b" "$p" "$base" >/dev/null 2>&1 || git -C "$cwd" worktree add -q "$p" "$b" >/dev/null
    printf '{"result":{"workspace":{"workspace_id":"w9"},"root_pane":{"pane_id":"w9:p1"},"worktree":{"path":"%s","branch":"%s"}}}\n' "$p" "$b" ;;
  "worktree remove")
    ws=""; while [ $# -gt 0 ]; do case "$1" in --workspace) shift; ws=$1;; esac; shift; done
    p=$(cat "${SHIM_WT_ROOT}/.ws-$ws" 2>/dev/null || true); [ -n "$p" ] && git -C "${SHIM_MAIN:?}" worktree remove --force "$p" >/dev/null 2>&1
    printf '{"result":{"type":"worktree_removed","workspace_id":"%s"}}\n' "$ws" ;;
  "workspace focus") echo '{"result":{"type":"ok"}}' ;;
  "workspace list")
    if [ -f "${SHIM_WT_ROOT}/.ws-w9" ]; then printf '{"result":{"workspaces":[{"workspace_id":"w9","worktree":{"checkout_path":"%s"}}]}}\n' "$(cat "${SHIM_WT_ROOT}/.ws-w9")"; else echo '{"result":{"workspaces":[]}}'; fi ;;
  "agent start")
    # Same name rule as herdr 0.9: the orchestrator once passed "plan-<40 char slug>" and nothing started.
    printf '%s' "$3" | grep -Eq '^[a-z][a-z0-9_-]{0,31}$' || { echo '{"error":{"code":"invalid_agent_name","message":"agent name must start with a lowercase letter and contain only lowercase letters, digits, '"'"'-'"'"' or '"'"'_'"'"' (1-32 characters)"}}'; exit 1; }
    if [ -n "${SHIM_AGENT_START_ERROR:-}" ]; then printf '{"error":{"code":"pane_busy","message":"%s"}}\n' "$SHIM_AGENT_START_ERROR"; exit 1; fi
    pane=""; while [ $# -gt 0 ]; do case "$1" in --pane) shift; pane=$1;; esac; shift; done
    # SHIM_AGENT_START_FAILS=1: claude exits at once (unknown agent), so no agent is ever detected.
    if [ "${SHIM_AGENT_START_FAILS:-0}" != 0 ]; then echo '{"error":{"code":"timeout"}}'; exit 1; fi
    printf '%s' "$pane" > "${SHIM_WT_ROOT:?}/.agent-pane"
    echo '{"result":{"ok":true}}' ;;
  "pane run")
    # A sandboxed worker is started by a command in the pane, not by `agent start`; Herdr detects the agent after.
    printf '%s' "$3" > "${SHIM_WT_ROOT:?}/.agent-pane"
    echo '{"result":{"type":"ok"}}' ;;
  "agent wait") echo '{"result":{"agent_status":"idle"}}' ;;
  "agent get")
    # The pane's agent, with the session identity herdr 0.9 reports for it. SHIM_NO_AGENT_SESSION drops that
    # field, the way a pane whose agent herdr has not identified answers.
    if [ -n "${SHIM_NO_AGENT_SESSION:-}" ]; then printf '{"result":{"agent":{"pane_id":"%s"}}}\n' "$3"; exit 0; fi
    printf '{"result":{"agent":{"pane_id":"%s","agent_session":{"agent":"claude","kind":"id","value":"%s"}}}}\n' \
      "$3" "$(cat "${SHIM_WT_ROOT}/.agent-session" 2>/dev/null || printf 'session-before')" ;;
  "agent prompt")
    # `/clear` starts a fresh Claude session, which herdr reports under a new id; SHIM_CLEAR_KEEPS_SESSION=1
    # is the pane that swallowed it and keeps the old context.
    if [ "$4" = "/clear" ] && [ -z "${SHIM_CLEAR_KEEPS_SESSION:-}" ]; then
      printf 'session-after-%s' "$(date +%s)$RANDOM" > "${SHIM_WT_ROOT:?}/.agent-session"
    fi
    echo '{"result":{"type":"ok"}}' ;;
  "pane read")
    case "${SHIM_AGENT_START_FAILS:-0}" in
      1) echo "--agent 'planner' not found. Available agents: claude, Explore" ;;
      2) printf 'error: option --plugin-dir argument missing\n\nadmin@mac plan-offline-mode %% \n' ;;
      *) echo "Welcome to Claude Code" ;;
    esac ;;
  "agent list")
    if [ -f "${SHIM_WT_ROOT}/.agent-pane" ]; then printf '{"result":{"agents":[{"pane_id":"%s","agent_status":"working"}]}}\n' "$(cat "${SHIM_WT_ROOT}/.agent-pane")"; else echo '{"result":{"agents":[]}}'; fi ;;
  "notification show") exit 0 ;;
  *) echo "herdr shim: unhandled: $*" >&2; exit 64 ;;
esac
